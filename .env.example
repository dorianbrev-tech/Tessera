# ─── Core ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://tessera:tessera@localhost:5432/tessera
APP_URL=http://localhost:3000
# 32+ random characters. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Defaults to true when APP_URL starts with https://
# SECURE_COOKIES=true

# ─── Claude (required for AI design synthesis, generation and edits) ──────────
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT_GENERATE=high      # low | medium | high | xhigh | max
# CLAUDE_EFFORT_CHAT=medium
# AGENT_MAX_TURNS=80

# ─── Storage: screenshots, uploads, images, fonts, fidelity diffs ────────────
STORAGE_DRIVER=local               # local | s3
# STORAGE_LOCAL_DIR=.data/storage
# S3-compatible (AWS S3, Cloudflare R2, MinIO, Backblaze B2…)
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# ─── Optional media providers ──────────────────────────────────────────────────
# Licensed stock photography search (either one)
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=
# AI image generation (either one)
# OPENAI_API_KEY=
# REPLICATE_API_TOKEN=
# IMAGE_GEN_PROVIDER=openai        # openai | replicate (auto-detected from keys)
# IMAGE_GEN_MODEL=                 # gpt-image-1 / black-forest-labs/flux-1.1-pro

# ─── Crawler ────────────────────────────────────────────────────────────────────
# CRAWLER_RESPECT_ROBOTS=true
# CRAWLER_BOT_TOKEN=TesseraBot     # appended to the User-Agent and matched in robots.txt
# CRAWLER_USER_AGENT=              # full override (not recommended)
# CRAWLER_MAX_PAGES_CAP=20
# CHROMIUM_EXECUTABLE_PATH=        # only if Playwright's bundled Chromium is unavailable
# Development/testing only: allow analysing localhost and private-network hosts.
# Never enable in production (SSRF protection).
# CRAWLER_ALLOW_PRIVATE_HOSTS=false

# ─── Worker & publishing ───────────────────────────────────────────────────────
# WORKER_CONCURRENCY=2
# Serve published sites from a separate origin (recommended in production), e.g.
# https://sites.example.com — the platform then links published sites there.
# PUBLIC_SITES_ORIGIN=
