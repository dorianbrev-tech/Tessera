{
  "name": "tessera",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI website analysis, recreation and generation platform",
  "scripts": {
    "dev": "concurrently -k -n web,worker -c cyan,magenta \"next dev -p ${PORT:-3000}\" \"tsx watch --env-file-if-exists=.env worker/index.ts\"",
    "dev:web": "next dev -p ${PORT:-3000}",
    "worker": "tsx --env-file-if-exists=.env worker/index.ts",
    "build": "next build",
    "start": "concurrently -k -n web,worker \"next start -p ${PORT:-3000}\" \"tsx --env-file-if-exists=.env worker/index.ts\"",
    "start:web": "next start -p ${PORT:-3000}",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test:analysis": "tsx --env-file-if-exists=.env scripts/test-analysis.ts",
    "fixtures": "node scripts/serve-fixtures.mjs",
    "postinstall": "node scripts/copy-monaco.mjs",
    "prebuild": "node scripts/copy-monaco.mjs",
    "test": "tsx --env-file-if-exists=.env --test tests/*.test.ts",
    "test:fidelity": "tsx --env-file-if-exists=.env scripts/test-fidelity.ts",
    "mock:claude": "node scripts/mock-claude.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@aws-sdk/client-s3": "^3.1163.0",
    "@monaco-editor/react": "^4.7.0",
    "concurrently": "^10.0.6",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.9.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.69.0",
    "monaco-editor": "^0.55.1",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.18.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3"
  }
}
